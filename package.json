{
  "name": "musicplayer",
  "version": "0.1.0",
  "description": "Desktop player for a Jellyfin music library",
  "private": true,
  "main": "electron/main.js",
  "build": {
    "appId": "com.musicplayer.desktop",
    "productName": "MusicPlayer",
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux tar.xz",
    "build:pi": "electron-builder --linux --arm64 tar.xz",
    "release:win": "node scripts/build-release.js --target win",
    "release:mac": "node scripts/build-release.js --target mac",
    "release:linux": "node scripts/build-release.js --target linux",
    "release:pi": "node scripts/build-release.js --target pi"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.0.0"
  }
}
